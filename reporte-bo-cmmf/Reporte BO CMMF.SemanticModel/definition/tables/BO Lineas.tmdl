		annotation SummarizationSetBy = Automatic

	partition 'BO Lineas' = m
		mode: import
		source =
				let
				    Columnas = {"CANAL", "GRUPO", "MLA", "NOMBRE MLA", "CODIGO 3A", "KAM", "OV", "OC", "LINEA", "FECHA PEDIDO", "DIAS", "FECHA CANCELACION OC", "ESTADO OC", "CMMF VIEJO", "CODIGO COMERCIAL VIEJO", "DESCR VIEJO", "PZAS BO", "PRECIO NETO", "$ BO", "CUENTA COMO", "PZAS PICKING VIEJO", "PICKING ID", "CMMF NUEVO", "CODIGO COMERCIAL NUEVO", "DESCR NUEVO", "OV YA TRAE EL NUEVO", "PZAS BO DEL NUEVO EN LA OV", "QUE HACER"},
				    Embebido = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), Columnas),
				    LeerExcel = (ruta as text) as table =>
				        let
				            Libro = Excel.Workbook(File.Contents(ruta), null, true),
				            Hoja = Libro{[Item = "Por linea SAP", Kind = "Sheet"]}[Data],
				            Fila = List.PositionOf(List.Transform(Hoja[Column1], each Text.Upper(Text.Trim(Text.From(_)))), "CANAL"),
				            Datos = Table.PromoteHeaders(Table.Skip(Hoja, Fila), [PromoteAllScalars = true]),
				            Seleccion = Table.SelectColumns(Datos, Columnas, MissingField.UseNull)
				        in
				            Seleccion,
				    // Si RutaExcel está vacío se usan los datos del corte guardados en el archivo
				    Origen = if RutaExcel = null or Text.Trim(RutaExcel) = "" then Embebido else LeerExcel(Text.Trim(RutaExcel)),
				    SoloLineas = Table.SelectRows(Origen, each [CANAL] <> null and Text.Upper(Text.Trim(Text.From([CANAL]))) <> "TOTAL" and [#"$ BO"] <> null),
				    Renombrado = Table.RenameColumns(SoloLineas, {
				        {"CANAL", "Canal"},
				        {"GRUPO", "Grupo"},
				        {"NOMBRE MLA", "Nombre MLA"},
				        {"CODIGO 3A", "Cliente"},
				        {"LINEA", "Linea"},
				        {"FECHA PEDIDO", "Fecha Pedido"},
				        {"DIAS", "Dias BO"},
				        {"FECHA CANCELACION OC", "Fecha Cancelacion OC"},
				        {"ESTADO OC", "Estado OC Origen"},
				        {"CMMF VIEJO", "CMMF Viejo"},
				        {"CODIGO COMERCIAL VIEJO", "Codigo Comercial Viejo"},
				        {"DESCR VIEJO", "Producto Viejo"},
				        {"PZAS BO", "Pzas BO"},
				        {"PRECIO NETO", "Precio Neto"},
				        {"$ BO", "Monto BO"},
				        {"CUENTA COMO", "Cuenta Como"},
				        {"PZAS PICKING VIEJO", "Pzas Picking Viejo"},
				        {"PICKING ID", "Picking ID"},
				        {"CMMF NUEVO", "CMMF Nuevo"},
				        {"CODIGO COMERCIAL NUEVO", "Codigo Comercial Nuevo"},
				        {"DESCR NUEVO", "Producto Nuevo"},
				        {"OV YA TRAE EL NUEVO", "OV Ya Trae Nuevo"},
				        {"PZAS BO DEL NUEVO EN LA OV", "Pzas BO Nuevo En OV"},
				        {"QUE HACER", "Que Hacer"}}),
				    Tipos = Table.TransformColumnTypes(Renombrado, {
				        {"Canal", type text},
				        {"Grupo", type text},
				        {"MLA", type text},
				        {"Nombre MLA", type text},
				        {"Cliente", type text},
				        {"KAM", type text},
				        {"OV", type text},
				        {"OC", type text},
				        {"Linea", Int64.Type},
				        {"Fecha Pedido", type date},
				        {"Dias BO", Int64.Type},
				        {"Fecha Cancelacion OC", type date},
				        {"Estado OC Origen", type text},
				        {"CMMF Viejo", type text},
				        {"Codigo Comercial Viejo", type text},
				        {"Producto Viejo", type text},
				        {"CMMF Nuevo", type text},
				        {"Codigo Comercial Nuevo", type text},
				        {"Producto Nuevo", type text},
				        {"Pzas BO", Int64.Type},
				        {"Precio Neto", type number},
				        {"Monto BO", type number},
				        {"Pzas Picking Viejo", Int64.Type},
				        {"Pzas BO Nuevo En OV", Int64.Type},
				        {"Cuenta Como", type text},
				        {"Picking ID", type text},
				        {"OV Ya Trae Nuevo", type text},
				        {"Que Hacer", type text}}, "en-US"),
				    Limpio = Table.TransformColumns(Tipos, {
				        {"Canal", Text.Trim, type text},
				        {"Grupo", Text.Trim, type text},
				        {"MLA", Text.Trim, type text},
				        {"Nombre MLA", Text.Trim, type text},
				        {"Cliente", Text.Trim, type text},
				        {"KAM", Text.Trim, type text},
				        {"OV", Text.Trim, type text},
				        {"OC", Text.Trim, type text},
				        {"Estado OC Origen", Text.Trim, type text},
				        {"CMMF Viejo", Text.Trim, type text},
				        {"Codigo Comercial Viejo", Text.Trim, type text},
				        {"Producto Viejo", Text.Trim, type text},
				        {"CMMF Nuevo", Text.Trim, type text},
				        {"Codigo Comercial Nuevo", Text.Trim, type text},
				        {"Producto Nuevo", Text.Trim, type text},
				        {"Cuenta Como", Text.Trim, type text},
				        {"Picking ID", Text.Trim, type text},
				        {"OV Ya Trae Nuevo", Text.Trim, type text},
				        {"Que Hacer", Text.Trim, type text}}),
				    ConKam = Table.TransformColumns(Limpio, {{"KAM", each if _ = null or _ = "" then "SIN KAM ASIGNADO" else _, type text}}),
				    ConClienteCorto = Table.AddColumn(ConKam, "Cliente Corto", each
				        if [Cliente] = null then "SIN CLIENTE"
				        else let p = Text.PositionOf([Cliente], "·") in if p >= 0 then Text.Trim(Text.Middle([Cliente], p + 1)) else [Cliente], type text),
				    ConLineaId = Table.AddColumn(ConClienteCorto, "Linea ID", each Text.From([OV]) & "-" & Text.From([Linea]), type text),
				    ConCorte = Table.AddColumn(ConLineaId, "Fecha Corte", each
				        if [Fecha Pedido] = null or [Dias BO] = null then null else Date.AddDays([Fecha Pedido], [Dias BO]), type date),
				    ConDiasCancelar = Table.AddColumn(ConCorte, "Dias Para Cancelar OC", each
				        if [Fecha Cancelacion OC] = null or [Fecha Corte] = null then null else Duration.Days([Fecha Cancelacion OC] - [Fecha Corte]), Int64.Type),
				    ConEstado = Table.AddColumn(ConDiasCancelar, "Estado OC", each
				        let e = if [Estado OC Origen] = null then "" else Text.Upper([Estado OC Origen]) in
				        if e = "VENCIDA" then "Vencida"
				        else if Text.StartsWith(e, "VENCE") then "Vence en 7 días"
				        else if e = "VIGENTE" then "Vigente"
				        else "Sin estado", type text),
				    ConEstadoOrden = Table.AddColumn(ConEstado, "Estado OC Orden", each
				        if [Estado OC] = "Vencida" then 1 else if [Estado OC] = "Vence en 7 días" then 2 else if [Estado OC] = "Vigente" then 3 else 9, Int64.Type),
				    ConAccion = Table.AddColumn(ConEstadoOrden, "Accion", each
				        let a = if [Que Hacer] = null then "" else Text.Upper([Que Hacer]) in
				        if Text.StartsWith(a, "CAMBIAR AL CMMF NUEVO") then "Cambiar al CMMF nuevo"
				        else if Text.StartsWith(a, "CAMBIAR SOLO EL BO") then "Cambiar solo el BO"
				        else if Text.StartsWith(a, "REVISAR") then "Revisar: OV ya trae el nuevo"
				        else if Text.StartsWith(a, "CONFIRMAR") then "Confirmar con cliente"
				        else "Otra acción", type text),
				    ConAccionOrden = Table.AddColumn(ConAccion, "Accion Orden", each
				        if [Accion] = "Cambiar al CMMF nuevo" then 1
				        else if [Accion] = "Cambiar solo el BO" then 2
				        else if [Accion] = "Revisar: OV ya trae el nuevo" then 3
				        else if [Accion] = "Confirmar con cliente" then 4
				        else 9, Int64.Type),
				    ConAntiguedad = Table.AddColumn(ConAccionOrden, "Antiguedad BO", each
				        if [Dias BO] = null then "Sin dato"
				        else if [Dias BO] <= 7 then "0-7 días"
				        else if [Dias BO] <= 15 then "8-15 días"
				        else if [Dias BO] <= 30 then "16-30 días"
				        else "Más de 30 días", type text),
				    ConAntiguedadOrden = Table.AddColumn(ConAntiguedad, "Antiguedad Orden", each
				        if [Dias BO] = null then 9
				        else if [Dias BO] <= 7 then 1
				        else if [Dias BO] <= 15 then 2
				        else if [Dias BO] <= 30 then 3
				        else 4, Int64.Type),
				    ConCambio = Table.AddColumn(ConAntiguedadOrden, "Cambio CMMF", each
				        (if [CMMF Viejo] = null then "" else [CMMF Viejo]) & " → " & (if [CMMF Nuevo] = null then "" else [CMMF Nuevo]), type text),
				    Resultado = Table.SelectColumns(ConCambio, {"Canal", "Grupo", "MLA", "Nombre MLA", "Cliente", "Cliente Corto", "KAM", "OV", "OC", "Linea", "Linea ID", "Fecha Pedido", "Dias BO", "Antiguedad BO", "Antiguedad Orden", "Fecha Cancelacion OC", "Dias Para Cancelar OC", "Estado OC", "Estado OC Orden", "Estado OC Origen", "Fecha Corte", "CMMF Viejo", "Codigo Comercial Viejo", "Producto Viejo", "CMMF Nuevo", "Codigo Comercial Nuevo", "Producto Nuevo", "Cambio CMMF", "Pzas BO", "Precio Neto", "Monto BO", "Pzas Picking Viejo", "Pzas BO Nuevo En OV", "Cuenta Como", "Picking ID", "OV Ya Trae Nuevo", "Que Hacer", "Accion", "Accion Orden"})
				in
				    Resultado

	annotation PBI_ResultType = Table
